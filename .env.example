# Exemplo: copie para .env e preencha suas credenciais locais.
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=medidor
DB_SSL=false
MQTT_BROKER=mqtt://broker.hivemq.com:1883
MQTT_TOPIC_DADOS=smart-meter/medidor/dados
MQTT_TOPIC_COMANDO=smart-meter/medidor/comando
MQTT_TOPIC_ALERTA=smart-meter/medidor/alerta
MQTT_TOPIC_LIMITE=smart-meter/medidor/config/limite
LIMITE_PICO_PADRAO=1000
